<div class="breadcomb-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="breadcomb-list">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                            <div class="breadcomb-wp">
                                <div class="breadcomb-icon">
                                    <i class="notika-icon notika-mail"></i>
                                </div>
                                <div class="breadcomb-ctn">
                                    <h2>@(ViewData["Title"] ?? "E-Posta Yönetimi")</h2>
                                    <p>Hoş geldiniz, <a href="/Profile/EditProfile" class="bread-ntd" style="text-decoration: underline;" title="Profili Düzenle">@(User.Identity?.Name ?? "Kullanıcı")</a></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-3">
                            <div class="breadcomb-report">
                                <a href="/Message/SendMessage" data-toggle="tooltip" data-placement="left" title="Yeni Mesaj Gönder" class="btn">
                                    <i class="notika-icon notika-edit"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
