@model AspNetCoreIdentityEmail.Models.IdentityModels.UserEditViewModel
@{
    ViewData["Title"] = "Profilimi Düzenle";
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Profil Bilgilerini Güncelle</h2>
                        <p>Hesap bilgilerinizi ve kişisel bilgilerinizi buradan güncelleyebilirsiniz. Şifrenizi değiştirmek istemiyorsanız şifre alanlarını boş bırakabilirsiniz.</p>
                    </div>

                    <form method="post" asp-action="EditProfile" asp-controller="Profile">
                        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 20px; font-weight: 600;"></div>

                        <div class="row" style="margin-bottom: 20px;">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="notika-icon notika-support"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label style="font-weight: 600;">Adınız</label>
                                        <input type="text" asp-for="Name" class="form-control" placeholder="Adınız..." required />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="notika-icon notika-support"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label style="font-weight: 600;">Soyadınız</label>
                                        <input type="text" asp-for="Surname" class="form-control" placeholder="Soyadınız..." required />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row" style="margin-bottom: 20px;">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="notika-icon notika-mail"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label style="font-weight: 600;">Kullanıcı Adı</label>
                                        <input type="text" asp-for="UserName" class="form-control" placeholder="Kullanıcı adı..." required />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="notika-icon notika-edit"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label style="font-weight: 600;">E-posta Adresi</label>
                                        <input type="email" asp-for="Email" class="form-control" placeholder="E-posta adresi..." required />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row" style="margin-bottom: 20px;">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="notika-icon notika-phone"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label style="font-weight: 600;">Telefon Numarası</label>
                                        <input type="text" asp-for="PhoneNumber" class="form-control" placeholder="Telefon numarası..." />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="notika-icon notika-map"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label style="font-weight: 600;">Şehir</label>
                                        <input type="text" asp-for="City" class="form-control" placeholder="Şehir..." />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row" style="margin-bottom: 20px;">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="notika-icon notika-picture"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label style="font-weight: 600;">Profil Fotoğrafı URL</label>
                                        <input type="text" asp-for="ImageUrl" class="form-control" placeholder="Fotoğraf bağlantısı..." />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row" style="margin-bottom: 20px;">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="notika-icon notika-form"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label style="font-weight: 600;">Yeni Şifre <small style="color: #888;">(İsteğe bağlı)</small></label>
                                        <input type="password" asp-for="Password" class="form-control" placeholder="Değiştirmek istemiyorsanız boş bırakın" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="notika-icon notika-form"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label style="font-weight: 600;">Yeni Şifre Tekrar <small style="color: #888;">(İsteğe bağlı)</small></label>
                                        <input type="password" asp-for="PasswordConfirm" class="form-control" placeholder="Değiştirmek istemiyorsanız boş bırakın" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-right" style="margin-top: 25px;">
                            <button type="submit" class="btn btn-success waves-effect" style="padding: 10px 30px; font-size: 15px;">
                                <i class="notika-icon notika-checked"></i> Bilgileri Güncelle
                            </button>
                            <a href="/Message/Inbox" class="btn btn-default waves-effect" style="padding: 10px 25px; font-size: 15px;">
                                Vazgeç
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
